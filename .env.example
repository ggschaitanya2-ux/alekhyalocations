# Alekhya Locations — copy to .env on the server (never commit .env)
PORT=3200

# Same Postgres database as Alekhya Gate, so all apps can join on locations.id
DATABASE_URL=postgres://alekhya:CHANGE_ME@127.0.0.1:5432/alekhya_gate

# MUST be the same value as JWT_SECRET in the Gate's .env —
# then Gate logins work here and Gate tokens are accepted by this API.
JWT_SECRET=copy-from-gate-env

# Who can change locations / who can manage types + hard delete
EDIT_ROLES=admin,pm
ADMIN_ROLES=admin

# Gate's users table + bcrypt password column
USERS_TABLE=users
USERS_PASSWORD_COL=password_hash

# Browser apps on other origins allowed to call this API (comma separated)
CORS_ORIGINS=https://150-241-247-25.sslip.io

# Read-only keys for server-to-server use, name:key (generate with: openssl rand -hex 24)
API_KEYS=
